{
	"name": "konficurator",
	"version": "1.0.0",
	"description": "Lightweight, browser-only configuration file manager for JSON and XML files",
	"main": "index.html",
	"type": "module",
	"homepage": "https://suomiton.github.io/konficurator/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/suomiton/konficurator.git"
	},
	"bugs": {
		"url": "https://github.com/suomiton/konficurator/issues"
	},
	"scripts": {
		"build": "npm run build:wasm:prod && node build-tools/vite-build.cjs",
		"build:prod": "npm run clean && npm run build:wasm:prod && node build-tools/vite-build.cjs && npm run build:optimize && npm run build:gzip && npm run postbuild:assets && npm run build:verify",
		"postbuild:assets": "cp -r styles build/ && cp -r samples build/ && mkdir -p build/parser-wasm/pkg && cp -r parser-wasm/pkg/* build/parser-wasm/pkg/ || true",
		"build:ts": "tsc",
		"build:wasm": "cd parser-wasm && wasm-pack build --target web --dev",
		"build:wasm:prod": "cd parser-wasm && wasm-pack build --target web --release",
		"build:optimize": "node build-tools/optimize.cjs",
		"build:gzip": "node build-tools/gzip.cjs",
		"watch": "tsc --watch",
		"serve": "python3 -m http.server 8080",
		"dev": "npm run build:wasm && vite dev",
		"dev:legacy": "npm run build:wasm && python3 -m http.server 8080",
		"preview": "vite preview",
		"clean": "rm -rf dist build parser-wasm/pkg",
		"test": "TS_NODE_COMPILER_OPTIONS='{\"noUnusedParameters\":false,\"noUnusedLocals\":false}' jest",
		"test:watch": "TS_NODE_COMPILER_OPTIONS='{\"noUnusedParameters\":false,\"noUnusedLocals\":false}' jest --watch",
		"test:coverage": "TS_NODE_COMPILER_OPTIONS='{\"noUnusedParameters\":false,\"noUnusedLocals\":false}' jest --coverage",
		"test:unit": "TS_NODE_COMPILER_OPTIONS='{\"noUnusedParameters\":false,\"noUnusedLocals\":false}' jest tests/unit",
		"test:integration": "TS_NODE_COMPILER_OPTIONS='{\"noUnusedParameters\":false,\"noUnusedLocals\":false}' jest tests/integration",
		"build:verify": "node build-tools/verify-build.cjs",
		"build:wasm:test": "wasm-pack build parser-wasm --target nodejs --dev --out-dir pkg-node",
		"pretest": "npm run build:wasm:test",
		"pretest:coverage": "npm run build:wasm:test",
		"pretest:unit": "npm run build:wasm:test",
		"pretest:integration": "npm run build:wasm:test",
		"test:rust": "cargo test --manifest-path parser-wasm/Cargo.toml",
		"lint:rust": "cargo clippy --manifest-path parser-wasm/Cargo.toml --all-targets -- -D warnings",
		"lint": "eslint src",
		"format:check": "prettier --check src"
	},
	"keywords": [
		"configuration",
		"json",
		"xml",
		"file-manager",
		"browser",
		"typescript"
	],
	"author": "Konficurator",
	"license": "MIT",
	"devDependencies": {
		"@jest/globals": "^29.7.0",
		"@types/jest": "^30.0.0",
		"@types/jsdom": "^27.0.0",
		"@types/node": "^24.10.0",
		"@typescript-eslint/parser": "^8.71.1",
		"clean-css": "^5.3.3",
		"eslint": "^10.12.0",
		"html-minifier-terser": "^7.2.0",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"jsdom": "^27.1.0",
		"prettier": "^3.9.9",
		"rollup": "npm:@rollup/wasm-node@4.53.1",
		"terser": "^5.44.1",
		"ts-jest": "^29.4.5",
		"typescript": "^5.9.3",
		"vite": "^5.4.10",
		"wasm-pack": "^0.15.0"
	},
	"engines": {
		"node": ">=22.13.0"
	},
	"overrides": {
		"rollup": "$rollup"
	}
}
